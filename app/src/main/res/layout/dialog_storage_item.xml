<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <EditText
        android:id="@+id/storageItemKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/storage_item_key"
        android:importantForAutofill="no"
        android:inputType="text">
        <requestFocus/>
    </EditText>

    <EditText
        android:id="@+id/storageItemValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/storage_item_value"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:minLines="3"
        android:maxLines="6"
        android:scrollHorizontally="false" />

    <TextView
        android:id="@+id/storageItemNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/material_grid_unit"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
