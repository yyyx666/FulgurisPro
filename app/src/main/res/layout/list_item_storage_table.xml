<!--
 One row of the IndexedDB records table: a header row, a record row, or the lone action row at the
 bottom. Its cells are added by RowAdapter: we have no idea how many columns a store needs until we
 have read a page of it.

 A store with enough fields needs more room for its columns than a screen has, and squeezing them
 into one is what leaves a field name cut off with no way to read it. So the cells are laid out at
 their own width and the row is scrolled sideways to reach the ones off screen. Android only knows
 one row at a time, and RowAdapter keeps them at the same offset: a table whose head has scrolled
 away from its records is not a table any more.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="?android:attr/listPreferredItemHeight"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding"
    android:paddingEnd="@dimen/dialog_padding">

    <HorizontalScrollView
        android:id="@+id/storageCellsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/storageCells"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <View
        android:id="@+id/storageCellsDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:visibility="gone" />

</LinearLayout>
