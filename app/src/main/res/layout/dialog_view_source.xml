<?xml version="1.0" encoding="utf-8"?><!--
  Whole page view source: the server's own HTML first, the rendered DOM one switch away.
  See WebBrowserActivity.showPageSource.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/view_source_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/view_source_original"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_source_original" />

        <RadioButton
            android:id="@+id/view_source_rendered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_source_rendered" />

    </RadioGroup>

    <TextView
        android:id="@+id/view_source_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="8dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <fulguris.view.CodeView
            android:id="@+id/dialog_multi_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:gravity="top|start" />

    </ScrollView>

</LinearLayout>
